---
import { Image } from 'astro:assets';
import FilmVisual from './FilmVisual.astro';
import { films, routes, type FilmKey, type Lang } from '../data/site';
import { filmPhoto } from '../data/photos';
interface Props { film: FilmKey; lang: Lang }
const { film, lang } = Astro.props;
const f = films[film];
const ph = filmPhoto[film];
---
<a class="film" href={routes[film][lang]}>
  <span class="img">
    {ph
      ? <Image src={ph.src} alt="" widths={[400, 700]} sizes="(max-width: 600px) 100vw, 25vw" style={`width:100%;height:100%;object-fit:cover;object-position:${ph.position}`} />
      : <FilmVisual visual={f.visual} />}
  </span>
  <span class="body">
    <span class="t">{f.name[lang]} {f.tail[lang]}</span>
    <span class="d">{f.short[lang]}</span>
    <span class="go">{lang === 'fr' ? 'En savoir plus' : 'Learn more'} <span aria-hidden="true">→</span></span>
  </span>
</a>
